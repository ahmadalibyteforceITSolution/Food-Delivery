    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^1.0.0",
    "mongoose": "^9.6.2",
    "pinia": "^3.0.4",
    "resend": "^4.8.0",
